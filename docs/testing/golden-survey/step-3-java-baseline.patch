+package com.ovengers.slotkey.support;
+
+import com.fasterxml.jackson.databind.JsonNode;
+import com.fasterxml.jackson.databind.ObjectMapper;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.nio.file.StandardOpenOption;
+import static org.assertj.core.api.Assertions.assertThat;
+
+/** Baseline-only, opt-in capture. CREATE_NEW prevents overwriting prior output. */
+public class JavaSurveyGolden {
+    public static JsonNode readGolden(ObjectMapper mapper, String path, JsonNode actual) throws Exception {
+        String capture = System.getenv("GOLDEN_SURVEY_CAPTURE_DIR");
+        if (capture != null) {
+            Path output = Path.of(capture, path + ".json");
+            Files.createDirectories(output.getParent());
+            Files.writeString(output, mapper.writerWithDefaultPrettyPrinter().writeValueAsString(actual) + "\n",
+                    StandardOpenOption.CREATE_NEW);
+        }
+        try (var input = JavaSurveyGolden.class.getResourceAsStream("/golden/" + path + ".json")) {
+            assertThat(input).as("Java a380133 golden: %s", path).isNotNull();
+            return mapper.readTree(input);
+        }
+    }
+    public static void assertGolden(ObjectMapper mapper, String path, Object value) throws Exception {
+        JsonNode actual = mapper.readTree(mapper.writeValueAsString(value));
+        assertThat(actual).isEqualTo(readGolden(mapper, path, actual));
+    }
+}
