+package com.ovengers.slotkey.outbox;
+
+import com.fasterxml.jackson.databind.ObjectMapper;
+import com.ovengers.slotkey.support.IntegrationTestSupport;
+import com.ovengers.slotkey.support.SurveyGoldenClockConfig;
+import org.junit.jupiter.params.ParameterizedTest;
+import org.junit.jupiter.params.provider.EnumSource;
+import org.springframework.beans.factory.annotation.Autowired;
+import org.springframework.context.annotation.Import;
+import org.springframework.jdbc.core.JdbcTemplate;
+import org.springframework.transaction.annotation.Transactional;
+import java.time.LocalDateTime;
+import java.util.ArrayList;
+import java.util.List;
+import java.util.Locale;
+import java.util.UUID;
+import static org.assertj.core.api.Assertions.assertThat;
+import static com.ovengers.slotkey.support.JavaSurveyGolden.readGolden;
+
+@Import(SurveyGoldenClockConfig.class)
+@Transactional
+class OutboxPayloadGoldenTest extends IntegrationTestSupport {
+    @Autowired private SlotReleasedRecorder recorder;
+    @Autowired private JdbcTemplate jdbc;
+    @Autowired private ObjectMapper mapper;
+    @ParameterizedTest @EnumSource(SlotReleasedRecorder.Reason.class)
+    void recordedPayloadKeepsJavaFields(SlotReleasedRecorder.Reason reason) throws Exception {
+        recorder.record(10L, 20L, reason);
+        var rows = jdbc.queryForList("SELECT * FROM outbox_event WHERE partition_key = '20'");
+        assertThat(rows).hasSize(1);
+        var row = rows.getFirst();
+        assertThat(row.get("event_type")).isEqualTo("SlotReleased");
+        assertThat(row.get("topic")).isEqualTo("slot-released");
+        assertThat(row.get("partition_key")).isEqualTo("20");
+        assertThat(row.get("status")).isEqualTo("PENDING");
+        assertThat(row.get("attempts")).isEqualTo(0);
+        assertThat(row.get("published_at")).isNull();
+        var actual = mapper.readTree(row.get("payload").toString());
+        var situation = reason.name().toLowerCase(Locale.ROOT).replace('_', '-');
+        var expected = readGolden(mapper, "outbox/slot-released-" + situation + "-payload", actual);
+        List<String> actualFields = new ArrayList<>(), expectedFields = new ArrayList<>();
+        actual.fieldNames().forEachRemaining(actualFields::add);
+        expected.fieldNames().forEachRemaining(expectedFields::add);
+        assertThat(actualFields).containsExactlyInAnyOrderElementsOf(expectedFields);
+        assertThat(actual.get("eventId").isTextual()).isTrue();
+        assertThat(actual.get("eventId").textValue()).isEqualTo(row.get("event_id"));
+        var eventId = UUID.fromString(actual.get("eventId").textValue());
+        assertThat(eventId.toString()).isEqualTo(actual.get("eventId").textValue());
+        assertThat(eventId.version()).isEqualTo(4);
+        assertThat(eventId.variant()).isEqualTo(2);
+        for (var field : List.of("reservationId", "reason", "occurredAt"))
+            assertThat(actual.get(field)).as(field).isEqualTo(expected.get(field));
+        assertThat(actual.get("reservationId").isIntegralNumber()).isTrue();
+        assertThat(LocalDateTime.parse(actual.get("occurredAt").textValue()))
+            .isEqualTo(LocalDateTime.of(2026, 10, 23, 9, 0));
+    }
+}
diff --git a/backend/src/test/java/com/ovengers/slotkey/reservation/controller/ReservationHttpSupplementGoldenTest.java b/backend/src/test/java/com/ovengers/slotkey/reservation/controller/ReservationHttpSupplementGoldenTest.java
