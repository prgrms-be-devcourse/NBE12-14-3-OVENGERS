@@ -0,0 +1,121 @@
+package com.ovengers.slotkey.reservation.controller;
+
+import com.fasterxml.jackson.databind.JsonNode;
+import com.fasterxml.jackson.databind.ObjectMapper;
+import com.ovengers.slotkey.global.security.jwt.JwtProvider;
+import com.ovengers.slotkey.reservation.entity.ReservationStatus;
+import com.ovengers.slotkey.support.ReservationIntegrationTestSupport;
+import com.ovengers.slotkey.support.SurveyGoldenClockConfig;
+import org.junit.jupiter.params.ParameterizedTest;
+import org.junit.jupiter.params.provider.CsvSource;
+import org.springframework.beans.factory.annotation.Autowired;
+import org.springframework.boot.test.autoconfigure.web.servlet.AutoConfigureMockMvc;
+import org.springframework.context.annotation.Import;
+import org.springframework.http.MediaType;
+import org.springframework.test.web.servlet.MockMvc;
+import java.util.ArrayList;
+import java.util.Map;
+import static java.nio.charset.StandardCharsets.UTF_8;
+import static org.assertj.core.api.Assertions.assertThat;
+import static org.springframework.test.web.servlet.request.MockMvcRequestBuilders.post;
+import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.status;
+import static com.ovengers.slotkey.support.JavaSurveyGolden.readGolden;
+
+@AutoConfigureMockMvc
+@Import(SurveyGoldenClockConfig.class)
+class ReservationHttpSupplementGoldenTest extends ReservationIntegrationTestSupport {
+    @Autowired private MockMvc mvc;
+    @Autowired private ObjectMapper mapper;
+    @Autowired private JwtProvider jwtProvider;
+    @ParameterizedTest(name = "{0} -> {1}")
+    @CsvSource({"pay,200", "extend,200", "force-cancel,200", "expired-pay,409"})
+    void responseBodyKeepsJavaHttpOutput(String situation, int httpStatus) throws Exception {
+        Long memberId = createMember(30000), spaceId = createSpace();
+        jdbcTemplate.update("UPDATE member SET email = 'golden-owner@slotkey.test' WHERE id = ?", memberId);
+        jdbcTemplate.update("UPDATE spaces SET name = 'golden-space' WHERE id = ?", spaceId);
+        var initial = situation.endsWith("pay") ? ReservationStatus.HELD : ReservationStatus.CONFIRMED;
+        var start = now().plusDays(2).withHour(10);
+        var end = start.plusHours(1);
+        Long reservationId = createReservation(memberId, spaceId, initial, start, end);
+        if (situation.equals("expired-pay"))
+            jdbcTemplate.update("UPDATE reservation SET hold_expires_at = ? WHERE id = ?", now().minusMinutes(1), reservationId);
+        Long actorId = memberId;
+        if (situation.equals("force-cancel")) {
+            actorId = createMember(0);
+            jdbcTemplate.update("UPDATE member SET role = 'ADMIN' WHERE id = ?", actorId);
+        }
+        var token = issueSessionBoundAccessToken(memberRepository.findById(actorId).orElseThrow(), jwtProvider);
+        var endpoint = switch (situation) {
+            case "force-cancel" -> "/api/v1/admin/reservations/" + reservationId + "/force-cancel";
+            case "extend" -> "/api/v1/reservations/" + reservationId + "/extend";
+            default -> "/api/v1/reservations/" + reservationId + "/pay";
+        };
+        var body = switch (situation) {
+            case "force-cancel" -> "{\"reason\":\"golden cancellation\"}";
+            case "extend" -> mapper.writeValueAsString(Map.of("expectedEndTime", end, "newEndTime", end.plusMinutes(30)));
+            default -> "{\"spaceVersion\":0}";
+        };
+        var request = post(endpoint).header("Authorization", "Bearer " + token)
+                .header("Idempotency-Key", "golden-" + situation).contentType(MediaType.APPLICATION_JSON).content(body);
+        var response = mvc.perform(request).andExpect(status().is(httpStatus)).andReturn().getResponse();
+        var actual = mapper.readTree(response.getContentAsString(UTF_8));
+        var fixture = "reservation/" + situation + "-" + (httpStatus == 409 ? "conflict" : "success");
+        var expected = readGolden(mapper, fixture, actual);
+        assertFields(actual, expected);
+        var fields = expected.fields();
+        while (fields.hasNext()) {
+            var field = fields.next();
+            if (field.getKey().equals("data")) {
+                var actualData = actual.get("data");
+                assertFields(actualData, field.getValue());
+                var generatedIds = Map.of("reservationId", reservationId, "spaceId", spaceId, "memberId", memberId);
+                var dataFields = field.getValue().fields();
+                while (dataFields.hasNext()) {
+                    var dataField = dataFields.next();
+                    var name = dataField.getKey();
+                    if (generatedIds.containsKey(name)) {
+                        assertThat(actualData.get(name).isIntegralNumber()).as(name).isTrue();
+                        assertThat(actualData.get(name).longValue()).isEqualTo(generatedIds.get(name));
+                    } else assertThat(actualData.get(name)).as("data." + name).isEqualTo(dataField.getValue());
+                }
+                assertThat(actualData.get("totalAmount").isIntegralNumber()).isTrue();
+            } else assertThat(actual.get(field.getKey())).as(field.getKey()).isEqualTo(field.getValue());
+        }
+        switch (situation) {
+            case "pay" -> {
+                assertThat(statusOf(reservationId)).isEqualTo("CONFIRMED");
+                assertThat(balanceOf(memberId)).isEqualTo(20000);
+                var replay = mvc.perform(request).andExpect(status().isOk()).andReturn().getResponse();
+                assertThat(mapper.readTree(replay.getContentAsString(UTF_8))).isEqualTo(actual);
+                assertThat(balanceOf(memberId)).isEqualTo(20000);
+                assertThat(countLedger(reservationId, "RESERVATION_CHARGE")).isEqualTo(1);
+            }
+            case "extend" -> {
+                assertThat(statusOf(reservationId)).isEqualTo("CONFIRMED");
+                assertThat(balanceOf(memberId)).isEqualTo(25000);
+                assertThat(countSlots(reservationId)).isEqualTo(3);
+            }
+            case "force-cancel" -> {
+                assertThat(statusOf(reservationId)).isEqualTo("CANCELLED");
+                assertThat(balanceOf(memberId)).isEqualTo(40000);
+                assertThat(countSlots(reservationId)).isZero();
+                assertThat(countLedger(reservationId, "REFUND")).isEqualTo(1);
+            }
+            case "expired-pay" -> {
+                assertThat(statusOf(reservationId)).isEqualTo("HELD");
+                assertThat(balanceOf(memberId)).isEqualTo(30000);
+                assertThat(countSlots(reservationId)).isEqualTo(2);
+                assertThat(countLedger(reservationId, "RESERVATION_CHARGE")).isZero();
+                assertThat(countIdempotencyKeys(memberId)).isZero();
+            }
+        }
+    }
+    private void assertFields(JsonNode actual, JsonNode expected) {
+        assertThat(actual.isObject()).isTrue();
+        var actualFields = new ArrayList<String>();
+        var expectedFields = new ArrayList<String>();
+        actual.fieldNames().forEachRemaining(actualFields::add);
+        expected.fieldNames().forEachRemaining(expectedFields::add);
+        assertThat(actualFields).containsExactlyInAnyOrderElementsOf(expectedFields);
+    }
+}
