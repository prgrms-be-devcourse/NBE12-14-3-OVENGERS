+package com.ovengers.slotkey.support;
+
+import com.fasterxml.jackson.databind.ObjectMapper;
+import com.ovengers.slotkey.access.service.InactiveMemberAccessLogService;
+import com.ovengers.slotkey.auth.service.AuthSessionService;
+import com.ovengers.slotkey.credit.controller.ChargeOrderController;
+import com.ovengers.slotkey.credit.service.ChargeOrderConfirmService;
+import com.ovengers.slotkey.credit.service.ChargeOrderService;
+import com.ovengers.slotkey.global.config.*;
+import com.ovengers.slotkey.global.error.GlobalExceptionHandler;
+import com.ovengers.slotkey.global.security.CurrentMemberArgumentResolver;
+import com.ovengers.slotkey.global.security.jwt.JwtProvider;
+import com.ovengers.slotkey.global.security.jwt.JwtUtil;
+import com.ovengers.slotkey.notification.controller.NotificationController;
+import com.ovengers.slotkey.notification.service.NotificationQueryService;
+import com.ovengers.slotkey.waitlist.controller.WaitlistController;
+import com.ovengers.slotkey.waitlist.service.WaitlistService;
+import org.junit.jupiter.api.BeforeEach;
+import org.springframework.beans.factory.annotation.Autowired;
+import org.springframework.beans.factory.annotation.Value;
+import org.springframework.boot.test.autoconfigure.web.servlet.*;
+import org.springframework.boot.test.mock.mockito.MockBean;
+import org.springframework.context.annotation.Import;
+import org.springframework.test.context.ActiveProfiles;
+import org.springframework.test.web.servlet.MockMvc;
+import java.nio.file.*;
+import java.nio.charset.StandardCharsets;
+import java.util.Map;
+import static org.assertj.core.api.Assertions.assertThat;
+import static org.mockito.ArgumentMatchers.*;
+import static org.mockito.BDDMockito.given;
+
+@WebMvcTest({ChargeOrderController.class, WaitlistController.class, NotificationController.class})
+@AutoConfigureMockMvc(print = MockMvcPrint.NONE)
+@ActiveProfiles("test")
+@Import({SecurityConfig.class, ClockConfig.class, JwtProvider.class, WebMvcConfig.class,
+        CurrentMemberArgumentResolver.class, GlobalExceptionHandler.class})
+public abstract class HttpBodyJavaSupport {
+    @Autowired protected MockMvc mvc;
+    @Autowired protected ObjectMapper mapper;
+    @MockBean protected ChargeOrderService chargeOrders;
+    @MockBean protected ChargeOrderConfirmService confirmations;
+    @MockBean protected WaitlistService waitlist;
+    @MockBean protected NotificationQueryService notifications;
+    @MockBean private AuthSessionService sessions;
+    @MockBean private InactiveMemberAccessLogService inactiveAccess;
+    @Value("${custom.jwt.secret-key}") private String secretKey;
+
+    @BeforeEach
+    void allowSession() {
+        given(sessions.validate(anyString(), anyLong())).willReturn(AuthSessionService.ValidationResult.VALID);
+    }
+
+    protected String authorization() {
+        return "Bearer " + JwtUtil.createToken(secretKey, 300_000L,
+                Map.of("id", 7L, "email", "user@slotkey.test", "role", "USER", "sid", "test-session"));
+    }
+
+    protected void compare(String path, byte[] body) throws Exception {
+        String capture = System.getenv("GOLDEN_HTTP_CAPTURE_DIR");
+        if (capture != null) {
+            Path target = Path.of(capture, path + ".json");
+            Files.createDirectories(target.getParent());
+            Files.write(target, body, StandardOpenOption.CREATE_NEW);
+        }
+        try (var input = getClass().getResourceAsStream("/golden/" + path + ".json")) {
+            assertThat(input).as("Java a380133 HTTP golden: %s", path).isNotNull();
+            assertThat(mapper.readTree(body)).isEqualTo(mapper.readTree(input));
+        }
+    }
+}
