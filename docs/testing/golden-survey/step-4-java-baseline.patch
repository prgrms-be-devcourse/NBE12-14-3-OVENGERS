+package com.ovengers.slotkey.notification;
+import com.ovengers.slotkey.support.HttpBodyJavaSupport;
+import com.ovengers.slotkey.notification.dto.response.NotificationResponse;
+import java.time.LocalDateTime;
+import java.util.List;
+import org.junit.jupiter.api.Test;
+import org.springframework.data.domain.PageImpl;
+import org.springframework.data.domain.PageRequest;
+import static org.mockito.BDDMockito.given;
+import static org.mockito.Mockito.verify;
+import static org.springframework.test.web.servlet.request.MockMvcRequestBuilders.get;
+import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.status;
+
+class NotificationListHttpBodyJavaGoldenTest extends HttpBodyJavaSupport {
+    @Test void listReturnsOrderedNotificationsAndJavaPageBody() throws Exception {
+        var pageable = PageRequest.of(1, 2);
+        var created = LocalDateTime.of(2026, 10, 16, 12, 0);
+        given(notifications.getMyNotifications(7L, pageable)).willReturn(new PageImpl<>(List.of(
+                new NotificationResponse(2L, 12L, "두 번째 알림", true, created.plusMinutes(1)),
+                new NotificationResponse(1L, 11L, "자리가 비었습니다", false, created)), pageable, 5L));
+        var response = mvc.perform(get("/api/v1/notifications").param("page", "1").param("size", "2")
+                .header("Authorization", authorization())).andExpect(status().isOk()).andReturn().getResponse();
+        compare("notification/list-nonfirst-page-ok", response.getContentAsByteArray());
+        verify(notifications).getMyNotifications(7L, pageable);
+    }
+}
