+package com.ovengers.slotkey.waitlist.controller;
+import com.ovengers.slotkey.support.HttpBodyJavaSupport;
+import com.ovengers.slotkey.waitlist.dto.response.WaitlistEntryResponse;
+import com.ovengers.slotkey.waitlist.entity.WaitlistStatus;
+import java.time.LocalDateTime;
+import org.junit.jupiter.api.Test;
+import org.springframework.http.MediaType;
+import static org.mockito.BDDMockito.given;
+import static org.mockito.Mockito.verify;
+import static org.springframework.test.web.servlet.request.MockMvcRequestBuilders.post;
+import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.status;
+
+class WaitlistApplyHttpBodyJavaGoldenTest extends HttpBodyJavaSupport {
+    @Test void waitingReturns201WithJavaBody() throws Exception {
+        var start = LocalDateTime.of(2026, 10, 20, 14, 0);
+        var end = start.plusHours(1);
+        given(waitlist.apply(7L, 3L, start, end)).willReturn(new WaitlistEntryResponse(
+                11L, 3L, start, end, WaitlistStatus.WAITING, 2L, LocalDateTime.of(2026, 10, 15, 9, 0)));
+        var response = mvc.perform(post("/api/v1/waitlist").header("Authorization", authorization())
+                .contentType(MediaType.APPLICATION_JSON)
+                .content("{\"spaceId\":3,\"startTime\":\"2026-10-20T14:00:00\",\"endTime\":\"2026-10-20T15:00:00\"}"))
+                .andExpect(status().isCreated()).andReturn().getResponse();
+        compare("waitlist/apply-waiting-created", response.getContentAsByteArray());
+        verify(waitlist).apply(7L, 3L, start, end);
+    }
+}
